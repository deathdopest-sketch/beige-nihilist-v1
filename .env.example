# Beige_nihilist — environment configuration
# Copy to .env and fill in values

# === StumbleChat credentials (REQUIRED) ===
BEIGE_LOGIN_EMAIL=
BEIGE_LOGIN_PASS=
BEIGE_BOT_NICK=beige_nihilist

# === Rooms (comma-separated) ===
BEIGE_ROOMS=meatspace

# === Camera (paths must be absolute or relative to project root) ===
BEIGE_CAM_VIDEO=./beige_cam/default.mp4
# BEIGE_CAM_VIDEOS=./beige_cam/video1.mp4,./beige_cam/video2.mp4

# === Data / log paths (default: ./Beige_Data and ./beige_boot.log) ===
# BEIGE_DATA_DIR=./Beige_Data
# BEIGE_LOG_FILE=./beige_boot.log

# === Ollama AI (runs locally) ===
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin3:8b
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# === Optional: vector memory backend ===
# BEIGE_VECTOR_BACKEND=memory
# BEIGE_VECTOR_SQLITE_PATH=./Beige_Data/beige_vector.db

# === Optional: HTTP API ===
# BEIGE_BOT_PORT=7002
# OWNER_SECRET=changeme

# === Optional: Postgres persistence ===
# PG_URL=postgres://...
